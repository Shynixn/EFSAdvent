{
  "name": "efslevel-hub",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:wasm": "pwsh -NoProfile -ExecutionPolicy Bypass -File build-wasm.ps1",
    "start": "npm run build:wasm && ng serve --host 0.0.0.0 --port 4200",
    "build": "npm run build:wasm && npm run build:level-index && ng build",
    "build:level-index": "node scripts/build-level-search-index.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "flexsearch": "^0.8.212",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/upng-js": "^2.1.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
